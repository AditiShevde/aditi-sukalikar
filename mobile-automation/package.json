{
  "name": "mobile-automation",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.27.0",
    "@types/node": "^25.5.0",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/cucumber-framework": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/visual-service": "^9.2.0",
    "allure-commandline": "^2.34.1",
    "appium": "^3.2.2",
    "appium-uiautomator2-driver": "^7.1.0",
    "dotenv": "^17.3.1",
    "expect-webdriverio": "^5.6.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "wdio": "tsx ./node_modules/@wdio/cli/bin/wdio.js run ./wdio.conf.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:allure": "npm run wdio && npm run allure:generate",
    "appium:doctor": "appium driver doctor uiautomator2",
    "android:list-avds": "sh -c '\"$ANDROID_HOME/emulator/emulator\" -list-avds'",
    "android:emulator": "sh -c 'if [ -z \"$ANDROID_HOME\" ]; then echo \"Set ANDROID_HOME (Android SDK root).\"; exit 1; fi; if [ -z \"$ANDROID_AVD\" ]; then echo \"Set ANDROID_AVD to an AVD name from: npm run android:list-avds\"; exit 1; fi; exec \"$ANDROID_HOME/emulator/emulator\" -avd \"$ANDROID_AVD\"'"
  }
}
